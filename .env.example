# ------------------------------------------------------------------
# Aplicación
# Valores de NODE_ENV: dev | qa | prod  (no hay otros)
# ------------------------------------------------------------------
NODE_ENV=dev
PORT=3000
API_PREFIX=api
APP_NAME=ms-template

# ------------------------------------------------------------------
# CORS
# Lista de orígenes autorizados, separados por coma. Vacío = no se autoriza
# ningún origen cruzado, que es el valor seguro por defecto.
# NUNCA uses '*' aquí: las peticiones se hacen con credenciales.
#   CORS_ORIGINS=https://app.midominio.cl,https://admin.midominio.cl
# ------------------------------------------------------------------
CORS_ORIGINS=

# ------------------------------------------------------------------
# Base de datos (intercambiable vía DB_TYPE)
# Valores soportados: postgres | mysql | mariadb | mssql | sqlite | better-sqlite3
#
# Drivers a instalar según el motor elegido:
#   postgres        -> pnpm add pg              (ya incluido)
#   mysql / mariadb -> pnpm add mysql2
#   mssql           -> pnpm add mssql
#   sqlite          -> pnpm add sqlite3
#   better-sqlite3  -> pnpm add better-sqlite3  (ya incluido como devDependency)
# ------------------------------------------------------------------
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ms_template
DB_SCHEMA=public

# Con DB_SSL=true el certificado del servidor SIEMPRE se valida.
# DB_SSL_CA solo hace falta si la CA del proveedor no está entre las raíces de
# confianza del sistema (RDS, Cloud SQL): pegá ahí el certificado en PEM.
DB_SSL=false
# DB_SSL_CA=

# PELIGROSO. synchronize altera el esquema para que coincida con las entidades:
# puede borrar columnas con todos sus datos. Solo se admite con NODE_ENV=dev.
# En qa o prod la app NO ARRANCA si está en true.
#
# Queda en false a propósito. Para crear el esquema en tu entorno local la
# primera vez, ponelo en true, levantá la app una vez y volvelo a false.
DB_SYNCHRONIZE=false

DB_LOGGING=false

# Para sqlite / better-sqlite3, DB_DATABASE es la ruta del archivo:
# DB_TYPE=better-sqlite3
# DB_DATABASE=:memory:

# ------------------------------------------------------------------
# Documentación de la API (OpenAPI generado por @nestjs/swagger, UI de Scalar)
#
# Solo se publica con NODE_ENV dev o qa. En prod queda apagada aunque
# DOCS_ENABLED=true: esta variable solo puede APAGARLA, nunca encenderla.
# ------------------------------------------------------------------
DOCS_ENABLED=true
DOCS_PATH=docs

# ------------------------------------------------------------------
# Logging
# LOG_PRETTY=false en producción: pino emite JSON por línea.
# ------------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
