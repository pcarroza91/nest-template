# pnpm >= 10 bloquea los scripts de instalación de las dependencias por defecto.
# Los paquetes autorizados a compilar binarios nativos se declaran de forma
# explícita en package.json > pnpm.onlyBuiltDependencies (hoy: better-sqlite3).

# Los paquetes de NestJS declaran peers amplios entre sí; no rompas el install por eso.
strict-peer-dependencies=false
